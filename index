                        <option value="clamps">Оснастка</option>
                        <option value="custom">Нестандартный размер</option>
                    </select>
                    <i class="fa-solid fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                </div>
            </div>

            <!-- Прикрепить ТЗ/чертеж -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">
                    Прикрепить ТЗ или чертеж
                </label>
                <label
                    for="quote-file"
                    class="flex items-center justify-between gap-3 rounded-md border border-dashed border-slate-300 px-4 py-3 text-sm cursor-pointer hover:border-orange-500 hover:bg-orange-50/50 transition-colors"
                >
                    <span class="flex items-center gap-2.5 text-slate-500 truncate" x-text="fileName || 'PDF, DWG, JPG до 10 МБ'"></span>
                    <span class="shrink-0 inline-flex items-center gap-1.5 text-orange-600 font-medium">
                        <i class="fa-solid fa-paperclip"></i>
                        Выбрать файл
                    </span>
                </label>
                <input
                    type="file"
                    id="quote-file"
                    name="attachment"
                    accept=".pdf,.dwg,.jpg,.jpeg,.png"
                    class="hidden"
                    @change="fileName = $event.target.files.length ? $event.target.files[0].name : ''"
                >
            </div>

            <!-- Согласие -->
            <label class="flex items-start gap-3 cursor-pointer">
                <input
                    type="checkbox"
                    name="consent"
                    required
                    x-model="consent"
                    class="mt-0.5 w-4 h-4 rounded border-slate-300 text-orange-600 focus:ring-orange-500 shrink-0"
                >
                <span class="text-xs text-slate-500 leading-relaxed">
                    Я согласен(а) на обработку персональных данных в соответствии с
                    <a href="privacy.html" class="text-orange-600 hover:underline">политикой конфиденциальности</a>
                </span>
            </label>

            <!-- Submit -->
            <button
                type="submit"
                :disabled="!consent"
                class="btn-glow w-full inline-flex items-center justify-center gap-2 bg-orange-600 hover:bg-orange-500 disabled:bg-slate-300 disabled:cursor-not-allowed disabled:shadow-none text-white text-sm font-semibold px-6 py-3.5 rounded-md transition-colors"
            >
                <i class="fa-solid fa-bolt"></i>
                Получить расчет стоимости за 15 минут
            </button>

            <p class="text-center text-[11px] text-slate-400">
                Работаем с НДС 20% · Отправляем счет и КП на почту
            </p>
        </form>
    </div>
</div>


    <script>
        // Общие скрипты сайта
    </script>

</body>
</html>
